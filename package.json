{
  "name": "blobbi-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @blobbi-kit/core && npm run build --workspace @blobbi-kit/react",
    "typecheck": "npm run typecheck --workspace @blobbi-kit/core && npm run typecheck --workspace @blobbi-kit/react",
    "test": "vitest run --reporter=dot",
    "clean": "rimraf packages/*/dist packages/*/*.tsbuildinfo",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@nostrify/nostrify": "^0.54.0",
    "@nostrify/react": "^0.6.4",
    "@tanstack/react-query": "^5.56.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.7.1",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.0.1",
    "semver": "^7.8.5",
    "tsup": "^8.3.5",
    "typescript": "^5.5.3",
    "vitest": "^4.1.8"
  }
}
