{
  "name": "@blobbi-kit/3d",
  "version": "0.1.0",
  "description": "Procedural 3D Blobbi for Babylon.js: the same V3 identity the SVG renderer draws, as a reusable game character.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "blobbi",
    "babylonjs",
    "3d",
    "procedural",
    "virtual-pet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danidfra/blobbi-kit.git",
    "directory": "packages/blobbi-3d"
  },
  "homepage": "https://github.com/Danidfra/blobbi-kit/tree/main/packages/blobbi-3d#readme",
  "bugs": {
    "url": "https://github.com/Danidfra/blobbi-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@blobbi-kit/renderer": "^0.6.0"
  },
  "peerDependencies": {
    "@babylonjs/core": ">=8.0.0"
  }
}
