{
  "name": "@blobbi-kit/core",
  "version": "0.1.0",
  "description": "Portable, framework-agnostic core domain logic for Blobbi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "blobbi",
    "nostr",
    "nostrify",
    "virtual-pet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danidfra/blobbi-kit.git",
    "directory": "packages/blobbi-core"
  },
  "homepage": "https://github.com/Danidfra/blobbi-kit/tree/main/packages/blobbi-core#readme",
  "bugs": {
    "url": "https://github.com/Danidfra/blobbi-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.3.1"
  },
  "peerDependencies": {
    "@nostrify/nostrify": "^0.53.0"
  }
}
