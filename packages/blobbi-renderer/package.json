{
  "name": "@blobbi/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Portable, host-independent React renderer for Blobbi characters: plain visual data in, deterministic SVG out.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "blobbi",
    "react",
    "svg",
    "renderer",
    "virtual-pet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danidfra/blobbi-kit.git",
    "directory": "packages/blobbi-renderer"
  },
  "homepage": "https://github.com/Danidfra/blobbi-kit/tree/main/packages/blobbi-renderer#readme",
  "bugs": {
    "url": "https://github.com/Danidfra/blobbi-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "preview": "node scripts/preview.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
