{
  "name": "@blobbi-kit/react",
  "version": "0.3.0",
  "description": "Portable, app-agnostic React hooks for Blobbi, built on @blobbi-kit/core.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "blobbi",
    "nostr",
    "nostrify",
    "react",
    "hooks",
    "virtual-pet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danidfra/blobbi-kit.git",
    "directory": "packages/blobbi-react"
  },
  "homepage": "https://github.com/Danidfra/blobbi-kit/tree/main/packages/blobbi-react#readme",
  "bugs": {
    "url": "https://github.com/Danidfra/blobbi-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "peerDependencies": {
    "@blobbi-kit/core": "^0.3.0",
    "@nostrify/nostrify": "^0.53.0",
    "@nostrify/react": "^0.6.3",
    "@tanstack/react-query": "^5.56.2",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@blobbi-kit/core": "*"
  }
}
